{
  "permissions": {
    "allow": [
      "Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(kubectl get:*)", "Bash(kubectl describe:*)", "Bash(kubectl logs:*)",
      "Bash(kubectl top:*)", "Bash(helm list:*)", "Bash(helm status:*)",
      "Bash(terraform plan)", "Bash(terraform validate)", "Bash(terraform fmt:*)",
      "Bash(docker ps:*)", "Bash(docker images:*)", "Bash(trivy:*)", "Bash(gitleaks:*)"
    ],
    "ask": [
      "Bash(git push:*)", "Bash(gh pr create:*)",
      "Bash(kubectl apply:*)", "Bash(kubectl rollout:*)",
      "Bash(terraform apply:*)", "Bash(helm install:*)", "Bash(helm upgrade:*)",
      "Bash(docker build:*)", "Bash(ansible-playbook:*)"
    ],
    "deny": [
      "Bash(terraform destroy:*)",
      "Bash(kubectl delete ns:*)", "Bash(kubectl delete namespace:*)",
      "Bash(helm uninstall:*)", "Bash(k3d cluster delete:*)",
      "Bash(multipass delete:*)", "Bash(docker system prune:*)",
      "Bash(git push --force:*)", "Bash(gh pr merge:*)",
      "Bash(rm -rf /:*)",
      "Read(./.env)", "Read(./**/*.pem)", "Read(./**/*.key)", "Read(./**/*.tfvars)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-destructive.sh" },
        { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/secret-scan.sh" }
      ]}
    ],
    "PostToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/audit-log.sh" }
      ]}
    ]
  }
}
