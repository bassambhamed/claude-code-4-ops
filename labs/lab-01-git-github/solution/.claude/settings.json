{
  "permissions": {
    "allow": ["Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(gh pr view:*)"],
    "ask": ["Bash(git push:*)", "Bash(gh repo create:*)", "Bash(gh pr create:*)"],
    "deny": ["Bash(git push --force:*)", "Bash(gh pr merge:*)", "Read(./.env)", "Read(./**/*.pem)"]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/secret-scan.sh" }
      ]}
    ]
  }
}
